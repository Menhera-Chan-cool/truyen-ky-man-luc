      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;padding:0;border:0;border-radius:6px;background:transparent;color:var(--reader-fg,#302b23);cursor:pointer;transition:background .15s,color .15s}.ds-icon:hover{background:color-mix(in srgb,currentColor 8%,transparent)}.ds-icon[aria-pressed=\"true\"]{background:color-mix(in srgb,var(--reader-accent,#8d342b) 15%,transparent);color:var(--reader-accent,#8d342b)}@media(max-width:600px){.ds-icon{width:40px;height:40px}}.ds-focus:focus-visible{outline:2px solid var(--reader-accent,#8d342b);outline-offset:4px}@media(prefers-reduced-motion:reduce){button{transition:none!important}}"
